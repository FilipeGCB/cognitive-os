{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-os.dev/schemas/distribution-manifest-v1.5.json",
  "title": "Cognitive OS V1.5 Distribution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "source_commit", "package_version", "included_assets", "projected_assets", "omitted_assets", "feature_availability", "schema_enforcement"],
  "properties": {
    "schema_version": {"const": "cognitive-os-distribution-manifest-v1.5"},
    "target": {"enum": ["agent-skills", "openai", "claude", "gemini"]},
    "source_commit": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"const": "UNRELEASED_WORKTREE"}]},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "included_assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./*-]*$"}},
    "projected_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./*-]*$"}},
    "omitted_assets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./*-]*$"}},
    "feature_availability": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "UNKNOWN"]}},
    "schema_enforcement": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
    "notes": {"type": "string", "maxLength": 1024, "pattern": "^[^\\r\\n\\u0000]*$"}
  }
}
