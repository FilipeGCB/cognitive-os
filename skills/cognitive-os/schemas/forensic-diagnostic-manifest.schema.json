{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-os.dev/schemas/forensic-diagnostic-manifest-v1.5.json",
  "title": "Cognitive OS V1.5 Forensic Diagnostic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id", "schema_version", "run_id", "window", "allowlisted_sources",
    "session_ids", "artifacts", "raw_conversation_included", "sanitized",
    "previewed", "consent_state"
  ],
  "properties": {
    "manifest_id": {"type": "string", "pattern": "^FDM-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4,16}$"},
    "schema_version": {"const": "cognitive-os-forensic-manifest-v1.5"},
    "run_id": {"type": "string", "pattern": "^CRR-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4,16}$"},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\r\\n]+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "ended_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\r\\n]+(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    },
    "allowlisted_sources": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$"}},
    "session_ids": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$"}},
    "artifacts": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$"}},
    "raw_conversation_included": {"const": false},
    "sanitized": {"const": true},
    "previewed": {"type": "boolean"},
    "consent_state": {"enum": ["NOT_ASKED", "DECLINED", "GRANTED", "REVOKED"]}
  }
}
