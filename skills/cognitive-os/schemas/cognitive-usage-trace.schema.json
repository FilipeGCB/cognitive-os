{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-os.dev/schemas/cognitive-usage-trace-v1.5.json",
  "title": "Cognitive OS V1.5 Local Cognitive Usage Trace",
  "description": "Strict local Flight Recorder record. Shared payloads use the sharedPayload definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cognitive_os_version", "host_family", "surface_class", "run_id", "event_id", "depth",
    "full_flow_audit", "phase_states", "capabilities_checked", "candidate_capabilities", "skills_loaded",
    "capability_events", "research", "failures", "side_effects", "fallbacks", "decision_state", "run_status",
    "stop_reason", "feedback", "local_operational"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "cognitive_os_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "host_family": {"enum": ["hermes", "chatgpt-work", "codex", "claude", "gemini", "generic", "unknown"]},
    "surface_class": {"enum": ["cli", "terminal", "work", "work-mobile", "desktop", "mobile", "unknown"]},
    "run_id": {"type": "string", "pattern": "^CRR-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4,16}$"},
    "event_id": {"type": "string", "pattern": "^EVT-[A-Fa-f0-9]{24}$"},
    "depth": {"enum": ["fast", "normal", "deep", "board360"]},
    "full_flow_audit": {"type": "boolean"},
    "phase_states": {"$ref": "#/$defs/phaseStates"},
    "capabilities_checked": {"$ref": "#/$defs/categoryList"},
    "candidate_capabilities": {"$ref": "#/$defs/categoryList"},
    "skills_loaded": {"$ref": "#/$defs/categoryList"},
    "capability_events": {"$ref": "#/$defs/capabilityEvents"},
    "research": {"$ref": "#/$defs/research"},
    "failures": {"$ref": "#/$defs/failures"},
    "side_effects": {"$ref": "#/$defs/sideEffects"},
    "fallbacks": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "supported_setting", "alternate_provider", "persisted_run_state", "manual_next_proof", "composed_research", "unknown"]}},
    "decision_state": {"enum": ["ready_to_decide", "decided", "test_required", "more_evidence_required", "blocked", "no_action_recommended", "recommendation_only", "unknown"]},
    "run_status": {"enum": ["complete", "partial", "failed", "blocked", "unknown"]},
    "stop_reason": {"enum": ["NOT_SET", "BOUNDED", "NO_MATERIAL_UNKNOWN", "NEXT_PROOF", "RATE_LIMITED", "PROVIDER_FAILURE", "USER_STOP", "UNKNOWN"]},
    "feedback": {"$ref": "#/$defs/feedback"},
    "local_operational": {"$ref": "#/$defs/localOperational"}
  },
  "$defs": {
    "category": {"enum": ["local_skill_discovery", "local_tool_discovery", "local_connector_discovery", "external_skill_discovery", "external_mcp_discovery", "custom_capability"]},
    "categoryList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/category"}},
    "phaseStates": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "context": {"$ref": "#/$defs/phaseState"}, "question": {"$ref": "#/$defs/phaseState"},
        "evidence": {"$ref": "#/$defs/phaseState"}, "depth": {"$ref": "#/$defs/phaseState"},
        "sources": {"$ref": "#/$defs/phaseState"}, "capabilities": {"$ref": "#/$defs/phaseState"},
        "research": {"$ref": "#/$defs/phaseState"}, "methods": {"$ref": "#/$defs/phaseState"},
        "challenge": {"$ref": "#/$defs/phaseState"}, "stop": {"$ref": "#/$defs/phaseState"},
        "recommendation": {"$ref": "#/$defs/phaseState"}
      }
    },
    "phaseState": {"enum": ["complete", "partial", "blocked", "not_applicable"]},
    "capabilityEvents": {
      "type": "object", "additionalProperties": false, "required": [
        "local_skill_discovery", "local_tool_discovery", "local_connector_discovery",
        "external_skill_discovery", "external_mcp_discovery", "custom_capability"
      ],
      "properties": {
        "local_skill_discovery": {"$ref": "#/$defs/capabilityResult"},
        "local_tool_discovery": {"$ref": "#/$defs/capabilityResult"},
        "local_connector_discovery": {"$ref": "#/$defs/capabilityResult"},
        "external_skill_discovery": {"$ref": "#/$defs/capabilityResult"},
        "external_mcp_discovery": {"$ref": "#/$defs/capabilityResult"},
        "custom_capability": {"$ref": "#/$defs/capabilityResult"}
      }
    },
    "capabilityResult": {"enum": ["success", "partial", "truncated", "rate_limited", "unavailable", "blocked", "failed", "not_called"]},
    "grounding": {"enum": ["success", "partial", "unavailable", "blocked", "failed", "not_called"]},
    "research": {
      "type": "object", "additionalProperties": false,
      "required": ["web_calls_bucket", "grounded_corpus", "notebooklm", "compaction_occurred"],
      "properties": {
        "web_calls_bucket": {"enum": ["0", "1-3", "4-10", "11+"]},
        "grounded_corpus": {"$ref": "#/$defs/grounding"},
        "notebooklm": {"$ref": "#/$defs/grounding"},
        "compaction_occurred": {"type": "boolean"}
      }
    },
    "failures": {
      "type": "object", "additionalProperties": false,
      "required": ["web_failure", "rate_limited", "provider_failure", "provider_classes"],
      "properties": {
        "web_failure": {"type": "boolean"}, "rate_limited": {"type": "boolean"},
        "provider_failure": {"type": "boolean"},
        "provider_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["unsupported_parameter", "rate_limited", "timeout", "truncated", "provider_error", "tool_error", "unknown"]}}
      }
    },
    "sideEffects": {
      "type": "object", "additionalProperties": false, "required": ["persistent_change", "types"],
      "properties": {
        "persistent_change": {"type": "boolean"},
        "types": {"type": "array", "uniqueItems": true, "items": {"enum": ["SKILL_MUTATED", "REFERENCE_MUTATED", "POLICY_MUTATED", "CONFIG_CHANGED", "PACKAGE_INSTALLED", "MCP_INSTALLED", "CONNECTION_CREATED", "FILE_CREATED", "FILE_MODIFIED", "CREDENTIAL_STATE_CHANGED", "OTHER_PERSISTENT_SIDE_EFFECT"]}}
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false, "required": ["helpfulness", "reason"],
      "properties": {
        "helpfulness": {"type": ["string", "null"], "enum": ["HELPED", "PARTIALLY_HELPED", "NOT_HELPED", null]},
        "reason": {"type": ["string", "null"], "enum": ["INSUFFICIENT_EVIDENCE", "INSUFFICIENT_DEPTH", "CAPABILITY_UNAVAILABLE_OR_INADEQUATE", "INSUFFICIENT_CONTEXT", "CLARITY", "OTHER", null]}
      }
    },
    "localOperational": {
      "type": "object", "additionalProperties": false, "required": ["web_search_count", "source_count", "event_ordinals"],
      "properties": {
        "web_search_count": {"type": "integer", "minimum": 0}, "source_count": {"type": "integer", "minimum": 0},
        "event_ordinals": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "sharedPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "cognitive_os_version", "host_family", "surface_class", "run_id", "event_id", "depth", "full_flow_audit", "capability_events", "research", "failures", "side_effects", "feedback", "decision_state", "run_status"],
      "properties": {
        "schema_version": {"const": 1},
        "cognitive_os_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "host_family": {"enum": ["hermes", "chatgpt-work", "codex", "claude", "gemini", "generic", "unknown"]},
        "surface_class": {"enum": ["cli", "terminal", "work", "work-mobile", "desktop", "mobile", "unknown"]},
        "run_id": {"type": "string", "pattern": "^CRR-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4,16}$"},
        "event_id": {"type": "string", "pattern": "^EVT-[A-Fa-f0-9]{24}$"},
        "depth": {"enum": ["fast", "normal", "deep", "board360"]}, "full_flow_audit": {"type": "boolean"},
        "capability_events": {"$ref": "#/$defs/capabilityEvents"}, "research": {"$ref": "#/$defs/research"},
        "failures": {"type": "object", "additionalProperties": false, "required": ["rate_limited", "provider_failure"], "properties": {"rate_limited": {"type": "boolean"}, "provider_failure": {"type": "boolean"}}},
        "side_effects": {"type": "object", "additionalProperties": false, "required": ["persistent_change"], "properties": {"persistent_change": {"type": "boolean"}}},
        "feedback": {"$ref": "#/$defs/feedback"},
        "decision_state": {"enum": ["ready_to_decide", "decided", "test_required", "more_evidence_required", "blocked", "no_action_recommended", "recommendation_only", "unknown"]},
        "run_status": {"enum": ["complete", "partial", "failed", "blocked", "unknown"]}
      }
    }
  },
  "x-shared-payload-definition": "#/$defs/sharedPayload"
}
