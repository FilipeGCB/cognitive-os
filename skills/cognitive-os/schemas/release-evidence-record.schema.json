{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-os.dev/schemas/release-evidence-record-v1.5.json",
  "title": "Cognitive OS V1.5 Release Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repository", "candidate_sha", "version", "source_tree_fingerprint",
    "manifests", "harness", "execution", "sut_models", "grader_models", "runtime_hosts",
    "tests", "behavioral_conformance", "critical_gates", "hermes_e2e", "work", "distribution", "telemetry",
    "collector", "known_limitations"
  ],
  "properties": {
    "schema_version": {"const": "cognitive-os-release-evidence-v1.5"},
    "repository": {"const": "FilipeGCB/cognitive-os"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "source_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "harness": {"$ref": "#/$defs/harness"},
    "execution": {"$ref": "#/$defs/execution"},
    "sut_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
    "grader_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
    "runtime_hosts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
    "tests": {"$ref": "#/$defs/tests"},
    "behavioral_conformance": {"$ref": "#/$defs/behavioralConformance"},
    "critical_gates": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED", "UNAVAILABLE"]}},
    "hermes_e2e": {"$ref": "#/$defs/status"},
    "work": {"$ref": "#/$defs/status"},
    "distribution": {"$ref": "#/$defs/status"},
    "telemetry": {"$ref": "#/$defs/status"},
    "collector": {"$ref": "#/$defs/status"},
    "known_limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\r\\n\\u0000]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_commit", "version"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"$ref": "#/$defs/name"}
      }
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha"},
        "schema_version": {"$ref": "#/$defs/name"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "started_at", "finished_at", "candidate_sha", "artifact_refs", "host_observed_identity"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^CRR-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4,16}$"},
        "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\r\\n]+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\r\\n]+(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "host_observed_identity": {"const": true}
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "failed", "critical_failures", "conformance_schema", "grader_independent"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "critical_failures": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "conformance_schema": {"$ref": "#/$defs/name"},
        "grader_independent": {"type": "boolean"},
        "model_results": {"type": "array", "items": {"$ref": "#/$defs/modelResult"}}
      }
    },
    "modelResult": {
      "type": "object", "additionalProperties": false,
      "required": ["sut", "grader", "passed", "total", "critical_failures", "truncated_cases", "invented_identity_cases"],
      "properties": {
        "sut": {"$ref": "#/$defs/name"},
        "grader": {"$ref": "#/$defs/name"},
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "critical_failures": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "truncated_cases": {"type": "array", "items": {"$ref": "#/$defs/name"}},
        "invented_identity_cases": {"type": "array", "items": {"$ref": "#/$defs/name"}}
      }
    },
    "providerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "name", "fingerprint", "observed"],
      "properties": {
        "provider": {"$ref": "#/$defs/name"},
        "name": {"$ref": "#/$defs/name"},
        "fingerprint": {"$ref": "#/$defs/sha"},
        "observed": {"const": true}
      }
    },
    "behavioralConformance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "status", "overall", "suite", "profile", "candidate_sha", "source_fingerprint",
        "eval_rubric_hash", "selection_complete", "critical_coverage_complete", "case_count",
        "completed_case_count", "pass_count", "required_pass_count", "critical_failures",
        "incomplete_case_ids", "sut_identity", "grader_identity", "grader_independent", "report"
      ],
      "properties": {
        "schema": {"const": "cognitive-os-conformance-v4"},
        "status": {"const": "COMPLETE"},
        "overall": {"const": "PASS"},
        "suite": {"const": "v1.5"},
        "profile": {"const": "final"},
        "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_fingerprint": {"$ref": "#/$defs/sha"},
        "eval_rubric_hash": {"$ref": "#/$defs/sha"},
        "selection_complete": {"const": true},
        "critical_coverage_complete": {"const": true},
        "case_count": {"const": 58},
        "completed_case_count": {"const": 58},
        "pass_count": {"type": "integer", "minimum": 1, "maximum": 58},
        "required_pass_count": {"type": "integer", "minimum": 1, "maximum": 58},
        "critical_failures": {"type": "array", "maxItems": 0},
        "incomplete_case_ids": {"type": "array", "maxItems": 0},
        "sut_identity": {"$ref": "#/$defs/providerIdentity"},
        "grader_identity": {"$ref": "#/$defs/providerIdentity"},
        "grader_independent": {"const": true},
        "report": {"$ref": "#/$defs/evidenceArtifact"}
      }
    },
    "evidenceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "source_commit"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED", "UNAVAILABLE"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
